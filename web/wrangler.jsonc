{
  "name": "clicker",
  "main": "src/index.js",
  "compatibility_date": "2024-12-01",
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/click.mp3"],
  },
  "routes": [
    {
      "pattern": "clicker.jer.app",
      "custom_domain": true,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CLICKER_ROOM",
        "class_name": "ClickerRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ClickerRoom"],
    },
  ],
}
